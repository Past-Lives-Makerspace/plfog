#!/bin/sh
# The uniform fleet entry point. Exit 0 = this repo is sound; non-zero = it is not.
# Generated by boop/ops/doctor/wire-check on 2026-10-03; edit freely, it will not be regenerated.
set -eu
cd "$(dirname "$0")"
# No .pyc files: a bytecode cache validated on (mtime seconds, source size) can
# serve STALE code when an edit is the same length within the same second, which
# faked a test result during mutation testing. See boop/ops/doctor/bugs/0007.
export PYTHONDONTWRITEBYTECODE=1
PY=python3
[ -x .venv/bin/python ] && PY=.venv/bin/python

# The project's own `make test`: its answer beats an inferred one.
# NOTE: this may be slow (plfog's full suite is 64-128 min in CI). The
# fleet runner times each repo out rather than waiting.
exec make test
