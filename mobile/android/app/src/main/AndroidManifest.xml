<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Backstop, not the primary fix. Android keeps @capacitor/push-notifications;
             @capacitor-firebase/messaging is an iOS-only dependency (on iOS the former yields
             only a raw APNs token, which FCM rejects). android.includePlugins in
             capacitor.config.ts already keeps the Firebase plugin out of this project, so this
             service normally is not in the merged manifest at all and the directive is a no-op.
             It stays because if that allowlist is ever widened or dropped, both plugins would
             declare a service on com.google.firebase.MESSAGING_EVENT, Firebase would deliver to
             only the first match, and Android push would break silently. The JS never calls
             FirebaseMessaging on Android, so removing it here is always safe. -->
        <service
            android:name="io.capawesome.capacitorjs.plugins.firebase.messaging.MessagingService"
            tools:node="remove" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Biometric sign in. BiometricPrompt gates the Keystore key that the rotating
         login secret is encrypted under (@capgo/capacitor-native-biometric). Without
         this the prompt never shows and the secret can never be read back. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
