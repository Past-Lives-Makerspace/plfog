# ===========================================
# Database
# ===========================================
# Local Docker Compose default — no changes needed for standard setup
DATABASE_URL=postgres://plfog:plfog@localhost:5432/plfog

# Production DB — only needed for `make db-pull-prod`
# Get this from Render dashboard > plfog database > External Connection String
PROD_DATABASE_URL=

# ===========================================
# Django
# ===========================================
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# Stripe (optional for local dev)
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FIELD_ENCRYPTION_KEY=

# ===========================================
# Email (optional — DEBUG mode prints to console)
# ===========================================
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@pastlives.space
BETA_FEEDBACK_EMAILS=josh@plaza.codes

# ===========================================
# Airtable Sync (optional)
# ===========================================
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_SYNC_ENABLED=false

# ===========================================
# Mailchimp (optional)
# ===========================================
# Newsletter/marketing subscribes. Both blank disables the integration entirely
# (no subscribe is ever attempted, and nothing errors).
# These are a FALLBACK: if an admin has pasted credentials into Site Settings
# (/manage/site-settings/), the stored values win. Prefer these env vars in a real
# deployment so an account-scoped key isn't sitting in the database in plaintext.
# The API key must keep its datacenter suffix, e.g. abc123...-us14.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# ===========================================
# Eventbrite (optional)
# ===========================================
# Lists opted-in classes on Eventbrite. Any blank value disables the push, and so does
# the "Sell classes on Eventbrite" toggle in Site Settings (off by default). Staging
# never pushes. The token is the account's private token (Account Settings, Developer
# Links, API Keys); the organization and venue IDs come from the Eventbrite API
# (GET /users/me/organizations/ and GET /organizations/{id}/venues/).
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_ORGANIZATION_ID=
EVENTBRITE_VENUE_ID=
# Secret path segment for the order webhook. Create the Eventbrite webhook (actions order.placed,
# order.updated, order.refunded) at https://<host>/billing/webhooks/eventbrite/<this value>/
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EVENTBRITE_WEBHOOK_SECRET=

# ===========================================
# Web Push (optional)
# ===========================================
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_ADMIN_EMAIL=

# ===========================================
# Sentry (optional)
# ===========================================
SENTRY_DSN=

# ===========================================
# Allauth
# ===========================================
ALLAUTH_TRUSTED_PROXY_COUNT=0

# ===========================================
# Infrastructure (set automatically on Render — ignore locally)
# ===========================================
# RENDER_EXTERNAL_HOSTNAME=
# CSRF_TRUSTED_ORIGINS=
# ADMIN_DOMAINS=
